# ===========================================================================
# HireSnap - environment manifest (the ONLY env file that belongs in git).
#
# Copy it and fill in the secrets:
#     cp docker/.env.example docker/.env.dev
#     cp docker/.env.example docker/.env.prod
# .env.dev / .env.prod are gitignored; this template is not. `python
# docker/sync_env.py --check` proves the three files still declare the same set
# of keys, and `sync_env.py --mode dev` creates or top-ups a file without ever
# rotating a value that is already there.
#
# Format: KEY=value, one per line, no `export`, no inline `# comment` after a
# value (Compose would keep the comment as part of the value).
#
# Compose expands ${...} references in THIS file from left to right, so a key
# that is referenced must be defined ABOVE the key referencing it. This is the
# same rule as R:\GPTHub\docker\.env.example:4-5; it exists because expansion
# is a single sequential pass, not a resolver.
#
# A double underscore means nesting: DB__HOST is the settings path, DB_HOST is
# what the service actually reads. The translation happens exactly once, in the
# compose `environment:` block, so the env file stays a settings tree while the
# application keeps its flat os.environ contract (same split as R:\GPTHub).
#
# Values here are DOCUMENTED PLACEHOLDERS, never working secrets: this file is
# committed, so a value in it is shared by everyone who copies it
# (scripts/check_env_parity.py fails such a value on purpose). 'make env' or a
# human replaces them per deployment; sync_env.py copies them verbatim and never
# invents a secret.
#
# Required keys are marked ":?" in their comment. The compose files spell them
# ${KEY:?message}, so a missing value stops `docker compose up` naming the key
# instead of letting a service start on a silent default (mirror of
# R:\GPTHub\docker\docker-compose.yaml:124-129, where a defaulted MinIO
# password would have published an object store to the whole network).
# ===========================================================================

# --- 0. Compose / build ----------------------------------------------------
# Python package index used by the backend image build (build ARG PIP_INDEX_URL).
PIP_INDEX_URL=https://pypi.org/simple
# npm registry used by the frontend image build (build ARG NPM_REGISTRY).
NPM_REGISTRY=https://registry.npmjs.org
# BuildKit is required: both Dockerfiles use --mount=type=cache for pip/npm.
DOCKER_BUILDKIT=1

# --- 1. Project / host ports -----------------------------------------------
# Compose project name; run.sh passes it as `-p`, so dev and prod containers,
# networks and volumes never collide (mirror of R:\GPTHub\docker\run.sh:210-216).
PROJECT_NAME=hiresnap-prod
# Which compose file this file belongs to: dev | prod. run.sh cross-checks it.
COMPOSE_MODE=prod
# Host port for the API. DEV ONLY - in prod the gateway is the only publisher.
BACKEND_PUBLISH_PORT=8080
# Host port for the frontend. DEV ONLY, same reason.
FRONTEND_PUBLISH_PORT=3000

# --- 2. API service --------------------------------------------------------
# Bind address inside the container. 0.0.0.0 is mandatory: 127.0.0.1 would be
# reachable from the container only, and the host port publish would hang.
HOST=0.0.0.0
# In-container API port. Keep 8080: the healthcheck and the gateway upstream
# hardcode it, and changing the host-side publish does not change it.
SERVER_PORT=8080
# Exactly TRUE or FALSE, upper case. service/main.py rejects any other spelling
# (see its _debug_flag helper) and uses it to enable uvicorn's reloader.
DEBUG=FALSE
# Ask for schema initialisation on start. The bootstrap runs only when DEBUG is
# exactly TRUE *and* this flag is true, so it is a reviewable intent that run.sh
# reports on, not a switch that can override the debug gate on its own.
# It also means MySQL must be reachable at boot: with INIT_DB on and the database
# down, the process exits before it binds instead of serving 503s.
INIT_DB=false
# Container path for uploads and .npy embeddings; also served read-only at /data.
DATA_PATH=/app/data
# REQUIRED (:?) Absolute origin used when the API builds file URLs. Compose spells
# it ${PUBLIC_BASE_URL:?...} because a silently inherited default would emit links
# to the wrong host. Replaces the old HOST:SERVER_PORT construction in
# service/shared/urls.py, which leaked the container port to browsers sitting
# behind the gateway.
PUBLIC_BASE_URL=https://hiresnap.example.com

# --- 3. Auth (JWT, RS256) --------------------------------------------------
# Access token lifetime in minutes. service/models/auth_models.py:57-59 reads it through
# _int_env (:51-58), so an unset or malformed value falls back to the 15 at :33.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days. service/models/auth_models.py:60-62 reads it through
# _int_env (:51-58), so an unset or malformed value falls back to the 7 at :34.
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT algorithm. service/models/auth_models.py:97 hardcodes RS256, so the pair must match.
JWT_ALGORITHM=RS256
# Private key path INSIDE the container (a mount target, not a host path).
JWT_PRIVATE_KEY_PATH=/app/secrets/certs/jwt-private.pem
# Public key path INSIDE the container.
JWT_PUBLIC_KEY_PATH=/app/secrets/certs/jwt-public.pem
# Generate the pair once, on the host, before the first start. Never commit it
# and never regenerate it: every issued token becomes invalid.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -out infra/certs/jwt-private.pem
#   openssl rsa -pubout -in infra/certs/jwt-private.pem \
#       -out infra/certs/jwt-public.pem
#   chmod 600 infra/certs/jwt-private.pem

# --- 4. CORS ---------------------------------------------------------------
# Browser origins allowed to call the API cross-origin, as a JSON array (a
# comma-separated list also works). Read by _cors_settings() in
# service/api/app.py and handed to CORSMiddleware, so this key IS the enforcement
# point - the gateway proxies, it does not filter by Origin.
#
# WHAT "*" DOES, and why an explicit list is better: a wildcard origin cannot be
# combined with credentials - browsers reject Access-Control-Allow-Origin: * when
# Allow-Credentials is true - so _cors_settings() forces credentials OFF for the
# wildcard. This app authenticates with a Bearer header, not a cookie, so that is
# survivable, but an explicit list keeps the legal credentialed pairing available
# and is what a real deployment should use. Leave it empty or set "*" to keep the
# legacy permissive behaviour.
CORS_ALLOW_ORIGINS=["https://hiresnap.example.com"]

# --- 5. Database (mapped to DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB) -
# MySQL host as seen from the backend container: the compose service name.
DB__HOST=mysql
# MySQL port inside the Docker network. Never published to the host.
DB__PORT=3306
# REQUIRED (:?) Application database user; compose spells it ${DB__USER:?set DB__USER in .env.<mode>}.
DB__USER=hiresnap
# REQUIRED (:?) Application database password; compose spells it ${DB__PASSWORD:?set DB__PASSWORD in .env.<mode>}.
DB__PASSWORD=change-me
# Schema name. Must equal MYSQL_DATABASE, otherwise the app connects to a
# database the container never created.
DB__NAME=hiresnap

# --- 6. MySQL container ----------------------------------------------------
# REQUIRED (:?) Root password of the mysql:5.7.44 container; compose spells it ${MYSQL_ROOT_PASSWORD:?set MYSQL_ROOT_PASSWORD in .env.<mode>}.
MYSQL_ROOT_PASSWORD=change-me
# Database the image entrypoint creates on first start.
MYSQL_DATABASE=hiresnap
# Unprivileged user created by the entrypoint. Keep equal to DB__USER.
MYSQL_USER=hiresnap
# REQUIRED (:?) Password of that user, kept equal to DB__PASSWORD; compose spells it ${MYSQL_PASSWORD:?set MYSQL_PASSWORD in .env.<mode>}.
MYSQL_PASSWORD=change-me

# --- 7. Storage ------------------------------------------------------------
# Uploads live on the host under infra/storage, never in a named volume, so they
# survive `docker compose down -v` (see docs/RUNBOOK.md). DATA_PATH - defined once
# in section 2 - is the container-side path of that mount; the two must agree.
#
# Two independent things live in this section and confusing them is the classic
# mistake: (a) the credentials the MinIO CONTAINER starts with, and (b) where the
# APPLICATION reads and writes bytes (service/infrastructure/storage.py). (a) alone
# does nothing for the app; (b) alone points at an endpoint nobody started.
# In-network endpoint; the browser never talks to it directly.
STORAGE__ENDPOINT=minio:9000
# REQUIRED (:?) MinIO root user, also the S3 access key; compose spells it ${STORAGE__ACCESS_KEY:?set ...} because a defaulted object-store password would publish storage with a known credential.
STORAGE__ACCESS_KEY=minioadmin
# REQUIRED (:?) MinIO root password, also the S3 secret key; compose spells it ${STORAGE__SECRET_KEY:?set ...} for the same reason.
STORAGE__SECRET_KEY=minioadmin
# Bucket reserved for uploads once the API grows an S3 backend.
STORAGE__BUCKET=hiresnap-uploads
# TLS to the storage endpoint. false is correct inside the compose network,
# where traffic never leaves the internal bridge.
STORAGE__SECURE=false
# Where service/infrastructure/storage.py puts new objects: local | s3.
# local writes under DATA_PATH with the same layout the upload code already uses
# (files/<uuid>.<ext>, embeddings/<ns>/<uuid>.npy), so nothing changes on disk.
# s3 talks to STORAGE__ENDPOINT. This is deliberately NOT derived from the
# STORAGE=1 flag below: flipping it moves where NEW uploads land, and the upload
# endpoint (service/infrastructure/uploads.py) still writes to DATA_PATH, so a
# flip would leave reads and writes pointing at different stores. Turn the flag
# on to run MinIO, then decide about this key separately.
STORAGE__BACKEND=local
# Key prefix for objects the facade creates; keeps a shared bucket browsable.
STORAGE__PREFIX=hiresnap
# Region the S3 client signs for. MinIO ignores it but boto3 requires a value.
STORAGE__REGION=us-east-1
# Lifetime in seconds of a generated download URL (presigned_url).
STORAGE__PRESIGN_TTL=3600

# --- 8. Frontend -----------------------------------------------------------
# API base URL BAKED INTO THE BUNDLE AT BUILD TIME (CRA inlines REACT_APP_*).
# Prod: same-origin "/api/" - the gateway rewrites /api/ to the backend /server/
# mount. Dev: absolute, because the bundle is loaded from :3000 while the API is
# published on :8080. Changing it requires a rebuild, not a restart.
REACT_APP_BASE_URL=/api/
# DaData (dadata.ru) suggestions token, reserved for a company/INN lookup.
# NOTHING READS IT TODAY: measured with `grep -rn process.env frontend/src`, the
# only hit is REACT_APP_BASE_URL in frontend/src/shared/api/apiConsts.js. The
# supplier-requisites form that consumed this was dead code and was deleted with
# the frontend restructure. The key stays wired end-to-end (manifest -> compose
# build arg -> frontend/docker/Dockerfile ARG/ENV) so adding the lookup later
# needs no image change. Empty is the normal and a VALID value. Never the ':?'
# form - a missing autocomplete token must not block a deployment.
#
# THIS VALUE IS PUBLIC. CRA inlines REACT_APP_* into the JavaScript bundle at
# build time, so anyone who loads the page can read it out of the asset. That is
# why it must be a rate-limited CLIENT key from the DaData dashboard and not a
# server secret; a secret-shaped value here is a leak, not a configuration.
DADATA_TOKEN=

# --- 9. Gateway (nginx) ----------------------------------------------------
# Public hostname: the vhost uses it as server_name and for redirects.
APP_DOMAIN=hiresnap.example.com
# Host port published for HTTP. 8088 keeps :80 free for other stacks on the box,
# the same reason R:\GPTHub\docker\docker-compose.yaml:159-165 publishes 8443.
NGINX_PUBLISH_HTTP=8088
# Host port published for HTTPS. The vhost listens on 443 only when TLS material
# exists in infra/certs; publishing the port without certs is harmless.
NGINX_PUBLISH_HTTPS=8443

# --- 10. Optional profiles (1 = on, 0 = off) -------------------------------
# These switches decide WHICH OPTIONAL SIDECARS START, not what the application
# talks to. docker/sidecar_profiles.sh reads them and, when a flag is on,
# EXPORTS the matching wiring keys (CACHE__BACKEND=redis, MAIL__HOST=mailpit,
# CELERY__ENABLED=true). A shell export wins over --env-file during compose
# interpolation, which is why the wiring keys above default to empty/false: an
# empty key means "let the flag decide", so the two settings can never
# contradict each other.
#
# The ml sidecar is NOT in this list and has no flag: it is a CORE service of
# every stack, because the API no longer contains an in-process inference path.
# What IS optional is the GPU it uses - see U below.
#
# Redis. Needed by the cache facade in redis mode AND by celery as the broker.
CACHE=1
# MinIO. Cheap to run; set STORAGE__BACKEND=s3 as a separate decision (see 7).
STORAGE=1
# Celery workers and beat. Off by default: without a Redis broker the stack runs
# jobs inline in the API process, which is a valid single-container deployment.
CELERY=0
# Mailpit, the SMTP sink with a web inbox. Off by default; the mail facade
# writes to a file when it is off, so nothing breaks without it.
MAIL=0

# --- 11. Cache (read by service/infrastructure/cache.py) -------------------
# memory | redis | noop. memory is a per-process LRU with TTL: correct, but it
# is NOT shared between the API and the workers, so a value cached in one is a
# miss in the other. redis makes it shared. Empty means "sidecar_profiles.sh
# decides from CACHE=1".
CACHE__BACKEND=
# Redis database number. 1, not 0, because the celery broker also lives in this
# instance and a FLUSHALL while debugging must not be able to erase job state.
CACHE__REDIS_URL=redis://cache:6379/1
# Namespace prefix for every key the facade writes (hiresnap:<ns>:<key>).
CACHE__PREFIX=hiresnap
# Default TTL in seconds applied when a caller passes none.
CACHE__TTL=300
# Entries kept by the memory backend before the LRU evicts.
CACHE__MAX_ENTRIES=2048
# Socket timeout for one Redis command, in seconds. The cache fails OPEN: a slow
# or dead Redis must degrade a request to a miss, never hang it or raise.
CACHE__TIMEOUT=0.5
# Seconds to stop trying after a transport failure before the next attempt.
CACHE__RETRY_BACKOFF=30

# --- 12. ML sidecar (read by ml/service/settings.py as FLAT names) ---------
# The sidecar never reads a double-underscore key: it is a separate service with
# its own flat contract, and compose is the single translation point.
# Bind address inside the sidecar container.
ML__HOST=0.0.0.0
# Sidecar port. 8080 for the same reason as SERVER_PORT: the image healthcheck,
# the compose healthcheck and the client default all assume it.
ML__PORT=8080
# Where the API and the workers reach the sidecar. This is NOT a fallback
# switch any more: the in-process inference path is gone, so an empty value
# means "inference is unavailable" rather than "run it in this process". Kept
# in the manifest (rather than hardcoded in compose) because pointing it at a
# sidecar on another host is a legitimate deployment. Read per request, so
# changing it needs a container restart, not a rebuild.
ML__SERVICE_URL=http://ml:8080
# Client connect timeout in seconds (ML_SERVICE_CONNECT_TIMEOUT).
ML__CONNECT_TIMEOUT=10
# Client read timeout in seconds (ML_SERVICE_TIMEOUT). 900 because a first
# /v1/embed/video downloads HF weights and then decodes a video on a GPU that may
# be busy; a shorter value turns a slow first call into a spurious failure.
ML__TIMEOUT=900
# THE FOUR KEYS BELOW ARE THE SIDECAR'S OWN SETTINGS, so they carry an ML_
# prefix in the settings tree and compose flattens them into the names
# ml/service/settings.py reads (ML_DEVICE -> DEVICE, ML_MAX_UPLOAD_MB -> MAX_UPLOAD_MB,
# ...). The prefix is what stops a future backend key of the same name from
# silently changing a sidecar setting: one translation point, no shared name.
#
# Torch device preference: empty = auto (cuda when available, else cpu).
ML_DEVICE=
# Largest accepted upload for /v1/embed/video, in MB. 413 above this.
ML_MAX_UPLOAD_MB=512
# Largest accepted text for /v1/embed/text, in characters. 413 above this.
ML_MAX_TEXT_CHARS=20000
# Seconds of idleness after which the sidecar frees VRAM. 0 disables the
# watchdog; a value is what lets one GPU be shared with another workload.
ML_MODEL_IDLE_UNLOAD_SECONDS=0

# --- 13. Mail (read by service/infrastructure/mail.py) ---------------------
# Master switch. false means every send is a logged no-op, which is the honest
# default: no code path today sends mail, and a silent SMTP attempt would make
# an unconfigured deployment look broken.
MAIL__ENABLED=false
# file | smtp. file appends to MAIL__FILE_PATH (dev, no server needed); smtp is
# the only backend that exercises the real path. Empty means "sidecar_profiles.sh
# decides from MAIL=1".
MAIL__BACKEND=file
# SMTP host. Empty keeps the facade on its offline path; mailpit sets it to the
# compose service name.
MAIL__HOST=
# SMTP port. Empty = the backend default for the encryption it is given.
MAIL__PORT=
# SMTP credentials. An empty user means no AUTH is attempted (mailpit accepts
# that). The value in this committed file is a placeholder on purpose.
MAIL__USER=
MAIL__PASSWORD=change-me
# Envelope sender. Must be a domain the SMTP server accepts.
MAIL__FROM=no-reply@hiresnap.local
# STARTTLS on 587, implicit TLS on 465. Both false = plain, which is correct
# only on the internal bridge (mailpit).
MAIL__STARTTLS=true
MAIL__SSL=false
# Socket timeout in seconds for one SMTP conversation.
MAIL__TIMEOUT=10
# File the `file` backend appends to (inside the container; /app/logs is
# mounted from infra/logs so the outbox is readable on the host).
MAIL__FILE_PATH=/app/logs/mail_outbox.log
# Mailpit inbox size. A catcher that grows without bound is a memory leak with
# a nice UI.
MP_MAX_MESSAGES=5000
# Dev-only host port for the Mailpit web inbox.
MAILPIT_PUBLISH_PORT=8025

# --- 14. Celery (read by service/infrastructure/messaging/*) ---------------
# Master switch. false means job_service.enqueue() runs the task INLINE in the
# request process: no broker, no worker, no lost jobs on a single-box setup.
CELERY__ENABLED=false
# Broker and result backend. Both default to Redis db 1 (see CACHE__REDIS_URL).
CELERY__BROKER_URL=redis://cache:6379/1
CELERY__RESULT_BACKEND=redis://cache:6379/1
# Seconds between orphan-upload sweeps (beat schedule). Read at beat start.
CELERY__CLEANUP_INTERVAL_SECONDS=3600
# Seconds between nightly embedding reindex runs.
CELERY__REINDEX_INTERVAL_SECONDS=86400
# Prefork children per worker. Queue boundaries are failure domains, not
# priorities, so the numbers differ per queue: maintenance work is I/O bound and
# one child is enough, the ML queue holds a GPU per child.
CELERY_AGENTS_CONCURRENCY=2
CELERY_MAINTENANCE_CONCURRENCY=1
CELERY_ML_CONCURRENCY=1

# --- 15. GPU and model weights (read by the ml service and run.sh) ---------
# Whether this HOST has an NVIDIA runtime for the sidecar. 1 applies
# docker/docker-compose.gpu.yaml, which adds the device reservation; 0 runs the
# sidecar on CPU.
#
# This is a separate flag from the profiles above because it is not a question
# of which containers start - the sidecar always starts - but of what it is
# allowed to use. A deploy.resources block on a host WITHOUT the runtime is a
# container that fails to start with a driver error, so the requirement lives in
# an override file that an operator opts into. Getting it wrong the other way
# (GPU=1 on a CPU box) is loud and immediate, which is the correct failure.
GPU=0
# GPUs the NVIDIA runtime exposes: "all" or a comma list such as "0,1".
NVIDIA_VISIBLE_DEVICES=all
# Driver capabilities the CUDA stack needs; "compute,utility" is the minimum.
NVIDIA_DRIVER_CAPABILITIES=compute,utility
# These two are HOST paths, relative to docker/ - they are the LEFT-hand side of
# the bind mount. The right-hand side is a fixed container path
# (/app/models/weights, /app/models/pretrained_ckpts) chosen by
# ml/service/settings.py, so do not put a host path there: compose would
# interpolate it, Docker would accept it, and the sidecar would then look in a
# directory that exists in the image but holds nothing.
#
# Host directory with trained checkpoints (Unet3D.pth), mounted read-only.
WEIGHTS_DIR=../infra/models/weights
# Cosmos tokenizer checkpoints: <this dir>/Cosmos-Tokenizer-CV4x8x8/encoder.jit
# is the one file the video path loads (ml/service/settings.py:165-172).
PRETRAINED_CKPT_DIR=../infra/models/pretrained_ckpts
# HuggingFace cache INSIDE the container, kept in a named volume so the text and
# ASR models survive a recreate. This one IS a container path - it is passed
# through unchanged because the sidecar only ever reads it.
HF_HOME=/app/.cache/huggingface
